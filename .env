# ============================================================
# LaunchPad AI — environment configuration
# ============================================================
# Replay Mode requires NONE of these — it runs 100% offline.
# Only needed for "Live API Mode".

# Pick ONE provider's key and set LLM_MODEL accordingly.

# --- Default: Anthropic Claude ---
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=anthropic/claude-3-5-sonnet-20241022

# --- Free speed option: Groq (fastest streaming) ---
# GROQ_API_KEY=gsk_...
# LLM_MODEL=groq/llama-3.3-70b-versatile

# --- Free API option: Google Gemini ---
# GEMINI_API_KEY=...
# LLM_MODEL=gemini/gemini-1.5-flash
# LLM_MODEL=gemini/gemini-2.0-flash-lite

# --- Local offline: Ollama (run 100% locally) ---
# LLM_MODEL=ollama/qwen2.5:7b

# Server
PORT=8000
# DEV=1   # enable autoreload during development
